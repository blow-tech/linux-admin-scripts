#!/usr/bin/env bash
# GNU df: one collection pass, preserving the trailing mountpoint field.
set -euo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/../core/alert_engine.sh"
lock_script disk_alert
WARNING_THRESHOLD=${WARNING_THRESHOLD:-75}
CRITICAL_THRESHOLD=${CRITICAL_THRESHOLD:-90}
[[ $WARNING_THRESHOLD =~ ^[0-9]+$ && $CRITICAL_THRESHOLD =~ ^[0-9]+$ ]] || exit 2
(( WARNING_THRESHOLD < CRITICAL_THRESHOLD && CRITICAL_THRESHOLD <= 100 )) || exit 2
data=$(LC_ALL=C df -BM --output=fstype,size,used,avail,pcent,target) || {
    alert_critical disk_alert UNKNOWN 'Filesystem collection failed'; exit 1;
}
checked=0 failed=0
while read -r type size used avail percent mount; do
    case $type in Type|tmpfs|devtmpfs|udev|squashfs|overlay) continue ;; esac
    percent=${percent%%%}
    [[ $percent =~ ^[0-9]+$ && -n $mount ]] || { echo 'UNKNOWN: malformed df row' >&2; failed=1; continue; }
    checked=$((checked + 1))
    if (( percent >= CRITICAL_THRESHOLD )); then
        alert_critical disk_alert "$mount" "${percent}% used; $avail available"; failed=1
    elif (( percent >= WARNING_THRESHOLD )); then
        alert_warning disk_alert "$mount" "${percent}% used; $avail available"; failed=1
    else
        printf 'OK: %s %s%% used\n' "$mount" "$percent"
    fi
done <<< "$data"
(( checked > 0 )) || { echo 'UNKNOWN: no eligible filesystems checked' >&2; exit 1; }
(( failed == 0 ))
