#!/usr/bin/env bash
# CPU utilization and memory availability. Local output only; 0 OK, 1 high, 3 UNKNOWN.
set -uo pipefail
export LC_ALL=C
CPU_THRESHOLD=${CPU_THRESHOLD:-80}; MEM_THRESHOLD=${MEM_THRESHOLD:-80}
for n in "$CPU_THRESHOLD" "$MEM_THRESHOLD"; do
 [[ $n =~ ^[0-9]{1,3}$ ]] && ((10#$n>=1 && 10#$n<=100)) || { echo 'Invalid threshold' >&2; exit 2; }
done
unknown() { echo "UNKNOWN: $*" >&2; exit 3; }
raw=$(timeout -k 5 10 vmstat 1 2) || unknown 'vmstat failed'
idle=$(awk 'END{print $15}' <<< "$raw")
[[ $idle =~ ^[0-9]{1,3}$ ]] && ((10#$idle<=100)) || unknown 'Invalid idle sample'
cpu=$((100-10#$idle))
mem=$(timeout -k 5 10 free -b) || unknown 'free failed'
read -r total available <<< "$(awk '$1=="Mem:" {print $2,$7}' <<< "$mem")"
[[ $total =~ ^[1-9][0-9]*$ && $available =~ ^[0-9]+$ ]] && ((available<=total)) || unknown 'Invalid MemAvailable sample'
used=$(((total-available)*100/total))
printf 'CPU utilization: %s%%; memory used excluding available cache: %s%%\n' "$cpu" "$used"
if ((cpu>=10#$CPU_THRESHOLD || used>=10#$MEM_THRESHOLD)); then echo 'THRESHOLD EXCEEDED' >&2; exit 1; fi
