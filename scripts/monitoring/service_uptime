#!/usr/bin/env bash
# Alert-only monitor. Supply intended service names explicitly.
set -euo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/../core/alert_engine.sh"
[[ $# -gt 0 ]] || { echo 'Usage: service_uptime <service> [service ...]' >&2; exit 2; }
lock_script service_uptime
checked=0 failed=0
for service in "$@"; do
    [[ $service =~ ^[a-zA-Z0-9_@.:-]+$ ]] || { echo 'Invalid unit name' >&2; exit 2; }
    checked=$((checked + 1))
    if ! state=$(systemctl show "$service" --property=LoadState,ActiveState --no-pager); then
        alert_critical service_uptime 'UNKNOWN: query failed' "$service"
        failed=$((failed + 1)); continue
    fi
    load= active=
    while IFS='=' read -r key value; do
        case $key in LoadState) load=$value ;; ActiveState) active=$value ;; esac
    done <<< "$state"
    if [[ $load == loaded && $active == active ]]; then
        printf 'OK: %s\n' "$service"
    else
        alert_critical service_uptime 'Service not healthy' "$service load=$load active=$active; no restart attempted"
        failed=$((failed + 1))
    fi
done
printf 'Checked=%s Failed=%s\n' "$checked" "$failed"
(( failed == 0 ))
