#!/usr/bin/env bash
# EXPECTED_BACKUP_SOURCE='<findmnt SOURCE>' bash backup_script <source> <existing-backup-directory>
set -euo pipefail
umask 077
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/../core/alert_engine.sh"
source "$SCRIPT_DIR/../core/backup_engine.sh"
[[ $# == 2 ]] || { echo 'Supply source and existing backup directory' >&2; exit 2; }
lock_script backup_script
backup_preflight "$1" "$2"
JOB_ID=$(printf %s "$SOURCE_DIR" | sha256sum | cut -c1-16)
BACKUP_FILE="$BACKUP_DIR/admin-backup-${JOB_ID}-$(date -u +%Y%m%dT%H%M%S)-$$.tar.gz"
create_verified_archive "$BACKUP_FILE"
alert_info backup_script 'Backup verified' "$BACKUP_FILE"
preview_retention "$BACKUP_DIR" "admin-backup-${JOB_ID}-*.tar.gz" "${KEEP_DAYS:-7}"
